    41                                  ; ============================================================ CPUID
    42                                  CPUF_OSYMM      equ 1 << 0      ; OS saves YMM state (OSXSAVE and XCR0[2:1] = 11b)
    43                                  CPUF_AVX        equ 1 << 1
    44                                  CPUF_AVX2       equ 1 << 2
    45                                  CPUF_FMA        equ 1 << 3
    46                                  CPUF_BMI1       equ 1 << 4
    47                                  CPUF_BMI2       equ 1 << 5
    48                                  CPUF_AVXVNNI    equ 1 << 6      ; VEX vpdpbusd / vpdpwssd
    49                                  CPUF_VNNIINT8   equ 1 << 7      ; VEX vpdpbssd family
    50                                  CPUF_VNNIINT16  equ 1 << 8
    51                                  CPUF_AVX512F    equ 1 << 9      ; raw CPUID bit, reported to show its absence
    52                                  
    53                                  %macro FEAT 3                   ; reg, bit, flag
    54                                      bt      %1, %2
    55                                      jnc     %%no
    56                                      or      r10d, %3
    57                                  %%no:
    58                                  %endmacro
