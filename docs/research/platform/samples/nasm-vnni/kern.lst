     1                                  ; kern.asm - NASM win64 sample for the native platform research.
     2                                  ;   nasm -f win64 kern.asm -o kern.obj
     3                                  ;
     4                                  ; Contents
     5                                  ;   cpu_features / cpuid_raw            CPUID feature detection
     6                                  ;   nn_mv32x64_*                        int8 matrix-vector kernels (32 outputs, 64 inputs)
     7                                  ;   morton3_pdep, morton3_pdep_batch,
     8                                  ;   morton3_pext_x                      BMI2 3D Morton code, 3 x 10 bits
     9                                  ;   abi_check, clobber_*                self-test of the PROC/EPILOGUE macros
    10                                  ;   spin_add8                           8-cycle-per-iteration loop (core clock estimate)
    11                                  
    12                                  bits 64
    13                                  default rel
    14                                  %include "win64.inc"
     1                              <1> ; win64.inc - NASM macros for the Microsoft x64 calling convention.
     2                              <1> ;
     3                              <1> ;   PROC name, locals, nxmm [, gpr, gpr, ...]
     4                              <1> ;       name    function label (made global)
     5                              <1> ;       locals  bytes of local stack below the saved XMM area (rounded up to 16).
     6                              <1> ;               Give 32 or more if the function calls anything (shadow space).
     7                              <1> ;       nxmm    how many callee-saved XMM registers to save, always xmm6 upward
     8                              <1> ;               (nxmm = 3 saves xmm6, xmm7, xmm8).  0..10.  Needs AVX (vmovaps).
     9                              <1> ;       gpr...  callee-saved GPRs to save: any of rbx rbp rsi rdi r12 r13 r14 r15
    10                              <1> ;   EPILOGUE    restore everything and ret (may be used more than once)
    11                              <1> ;   ENDPROC     ends the function and emits its .pdata/.xdata unwind records
    12                              <1> ;
    13                              <1> ; After PROC:   rsp is 16-byte aligned,
    14                              <1> ;               [rsp .. rsp+locals)                  locals
    15                              <1> ;               [rsp+locals+16*i]                    saved xmm(6+i), aligned
    16                              <1> ;               STK_ARG(n), n >= 5                   the n-th argument
    17                              <1> ;               HOME(n), n = 1..4                    caller's home slot n (free scratch)
    18                              <1> ;
    19                              <1> ; Layout proof: at entry rsp = 8 (mod 16).  After k pushes rsp = 8+8k (mod 16).
    20                              <1> ; The frame PRO_FRAME = locals + 16*nxmm + (8 if k is even) brings it to 0 (mod 16).
    21                              <1> 
    22                              <1> %ifndef WIN64_INC
    23                              <1> %define WIN64_INC
