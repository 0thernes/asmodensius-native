    60                                  ; uint32_t cpu_features(void);   AVX-class bits are set only when the OS saves YMM state.
    61                                  PROC cpu_features, 0, 0, rbx
    59                              <1>  %xdefine PRO_NAME %1
    60                              <1>  %assign PRO_LOC (((%2)+15) & ~15)
    61                              <1>  %assign PRO_NXMM %3
    62                              <1>  %assign PRO_NGPR %0-3
    63                              <1>  %if PRO_NXMM > 10
    64                              <1>  %error "PROC: nxmm must be 0..10"
    65                              <1>  %endif
    66                              <1>  %assign PRO_FRAME PRO_LOC + 16*PRO_NXMM + 8*((PRO_NGPR+1) & 1)
    67                              <1>  %if PRO_FRAME >= 4096
    68                              <1>  %error "PROC: frame of a page or more needs stack probing (__chkstk); not supported"
    69                              <1>  %endif
