    48                              <1> ; callee-saved check: 1 for rbx rbp rsi rdi r12..r15
    49                              <1> %define CS_rbx 1
    50                              <1> %define CS_rbp 1
    51                              <1> %define CS_rsi 1
    52                              <1> %define CS_rdi 1
    53                              <1> %define CS_r12 1
    54                              <1> %define CS_r13 1
    55                              <1> %define CS_r14 1
    56                              <1> %define CS_r15 1
    57                              <1> 
    58                              <1> %macro PROC 3-*
    59                              <1>     %xdefine PRO_NAME %1
    60                              <1>     %assign  PRO_LOC  (((%2)+15) & ~15)
    61                              <1>     %assign  PRO_NXMM %3
    62                              <1>     %assign  PRO_NGPR %0-3
    63                              <1>     %if PRO_NXMM > 10
    64                              <1>         %error "PROC: nxmm must be 0..10"
    65                              <1>     %endif
    66                              <1>     %assign  PRO_FRAME PRO_LOC + 16*PRO_NXMM + 8*((PRO_NGPR+1) & 1)
    67                              <1>     %if PRO_FRAME >= 4096
    68                              <1>         %error "PROC: frame of a page or more needs stack probing (__chkstk); not supported"
    69                              <1>     %endif
    70                              <1>     global %1
    71                              <1>     align 16
    72                              <1> %1:
    73                              <1>     %rotate 3
    74                              <1>     %assign PRO_I 0
    75                              <1>     %rep PRO_NGPR
    76                              <1>         %ifndef CS_%1
    77                              <1>             %error "PROC: not a callee-saved GPR:" %1
    78                              <1>         %endif
    79                              <1>         push    %1
    80                              <1>         .pro_g%[PRO_I]:
    81                              <1>         %xdefine PRO_GPR%[PRO_I]  %1
    82                              <1>         %assign  PRO_GNUM%[PRO_I] GN_%+%1
    83                              <1>         %assign  PRO_I PRO_I+1
    84                              <1>         %rotate 1
    85                              <1>     %endrep
    86                              <1>     %if PRO_FRAME > 0
    87                              <1>         sub     rsp, PRO_FRAME
    88                              <1>     %endif
    89                              <1>     .pro_alloc:
    90                              <1>     %assign PRO_I 0
    91                              <1>     %rep PRO_NXMM
    92                              <1>         %assign PRO_J PRO_I+6
    93                              <1>         vmovaps [rsp + PRO_LOC + 16*PRO_I], xmm%[PRO_J]
    94                              <1>         .pro_x%[PRO_I]:
    95                              <1>         %assign PRO_I PRO_I+1
    96                              <1>     %endrep
    97                              <1>     .pro_end:
    98                              <1> %endmacro
    99                              <1> 
   100                              <1> %define STK_ARG(n) [rsp + PRO_FRAME + 8*PRO_NGPR + 8*(n)]
   101                              <1> %define HOME(n)    [rsp + PRO_FRAME + 8*PRO_NGPR + 8*(n)]
   102                              <1> 
   103                              <1> %macro EPILOGUE 0
   104                              <1>     %assign PRO_I 0
   105                              <1>     %rep PRO_NXMM
   106                              <1>         %assign PRO_J PRO_I+6
   107                              <1>         vmovaps xmm%[PRO_J], [rsp + PRO_LOC + 16*PRO_I]
   108                              <1>         %assign PRO_I PRO_I+1
   109                              <1>     %endrep
   110                              <1>     %if PRO_FRAME > 0
   111                              <1>         add     rsp, PRO_FRAME
   112                              <1>     %endif
   113                              <1>     %assign PRO_I PRO_NGPR
   114                              <1>     %rep PRO_NGPR
   115                              <1>         %assign PRO_I PRO_I-1
   116                              <1>         pop     PRO_GPR%[PRO_I]
   117                              <1>     %endrep
   118                              <1>     ret
   119                              <1> %endmacro
   120                              <1> 
   121                              <1> ; Unwind records (x64 exception handling ABI).  Codes are listed in reverse
   122                              <1> ; order of the prologue.  UWOP_PUSH_NONVOL=0, UWOP_ALLOC_LARGE=1,
   123                              <1> ; UWOP_ALLOC_SMALL=2, UWOP_SAVE_XMM128=8.
   124                              <1> %macro ENDPROC 0
   125                              <1>     .pro_fend:
   126                              <1>   %ifndef NO_UNWIND               ; -DNO_UNWIND: negative control for the unwind test
   127                              <1>     %assign PRO_NCODE PRO_NGPR + 2*PRO_NXMM
   128                              <1>     %if PRO_FRAME > 128
   129                              <1>         %assign PRO_NCODE PRO_NCODE+2
   130                              <1>     %elif PRO_FRAME > 0
   131                              <1>         %assign PRO_NCODE PRO_NCODE+1
   132                              <1>     %endif
   133                              <1>     section .xdata rdata align=8
   134                              <1>     align 4, db 0
   135                              <1> %%ui:
   136                              <1>     db 0x01                         ; version 1, no handler flags
   137                              <1>     db .pro_end - PRO_NAME          ; size of prologue in bytes
   138                              <1>     db PRO_NCODE                    ; number of unwind code slots
   139                              <1>     db 0                            ; no frame register
   140                              <1>     %assign PRO_I PRO_NXMM
   141                              <1>     %rep PRO_NXMM
   142                              <1>         %assign PRO_I PRO_I-1
   143                              <1>         %assign PRO_J PRO_I+6
   144                              <1>         db .pro_x%[PRO_I] - PRO_NAME
   145                              <1>         db (PRO_J << 4) | 8
   146                              <1>         dw (PRO_LOC + 16*PRO_I) / 16
   147                              <1>     %endrep
   148                              <1>     %if PRO_FRAME > 128
   149                              <1>         db .pro_alloc - PRO_NAME
   150                              <1>         db 0x01
   151                              <1>         dw PRO_FRAME / 8
   152                              <1>     %elif PRO_FRAME > 0
   153                              <1>         db .pro_alloc - PRO_NAME
   154                              <1>         db (((PRO_FRAME - 8) / 8) << 4) | 2
   155                              <1>     %endif
   156                              <1>     %assign PRO_I PRO_NGPR
   157                              <1>     %rep PRO_NGPR
   158                              <1>         %assign PRO_I PRO_I-1
   159                              <1>         db .pro_g%[PRO_I] - PRO_NAME
   160                              <1>         db (PRO_GNUM%[PRO_I] << 4) | 0
   161                              <1>     %endrep
   162                              <1>     %if PRO_NCODE & 1
   163                              <1>         dw 0                        ; keep the slot count even
   164                              <1>     %endif
   165                              <1>     section .pdata rdata align=4
   166                              <1>     dd PRO_NAME  wrt ..imagebase
   167                              <1>     dd .pro_fend wrt ..imagebase
   168                              <1>     dd %%ui      wrt ..imagebase
   169                              <1>     section .text
   170                              <1>   %endif
   171                              <1> %endmacro
   172                              <1> 
   173                              <1> ; ---- AVX-VNNI in VEX encoding -------------------------------------------
   174                              <1> ; NASM 2.16.03 knows only the EVEX (AVX-512 VNNI) form of vpdpbusd and
   175                              <1> ; rejects "{vex} vpdpbusd" ("instruction not encodable with {vex} prefix").
   176                              <1> ; The EVEX form faults on a CPU without AVX-512, so the VEX form is emitted
   177                              <1> ; by hand:  VEX.256.66.0F38.W0 50 /r   vpdpbusd ymm1, ymm2, ymm3/m256
   178                              <1> ;   ymm1 += for each dword: sum of 4 products  u8(ymm2 byte) * s8(ymm3/m256 byte)
   179                              <1> ;
   180                              <1> ;   VPDPBUSD_RR  dst, src_u8, src_s8             (three ymm registers)
   181                              <1> ;   VPDPBUSD_RM  dst, src_u8, base_gpr, disp     (signed bytes at [base + disp])
   182                              <1> %macro VEX_0F38_66_256 3-4 0x50     ; dst#, vvvv#, rm#/base#, opcode
   183                              <1>     db 0xC4
   184                              <1>     db ((((%1)>>3)^1)<<7) | 0x40 | ((((%3)>>3)^1)<<5) | 0x02
   185                              <1>     db ((((%2)^15)&15)<<3) | 0x05
   186                              <1>     db %4
   187                              <1> %endmacro
   188                              <1> 
   189                              <1> %macro VPDPBUSD_RR 3
   190                              <1>     VEX_0F38_66_256 YN_%+%1, YN_%+%2, YN_%+%3
   191                              <1>     db 0xC0 | (((YN_%+%1)&7)<<3) | ((YN_%+%3)&7)
   192                              <1> %endmacro
   193                              <1> 
   194                              <1> %macro VPDPBUSD_RM 4
   195                              <1>     %assign %%b GN_%+%3
   196                              <1>     %if (%%b & 7) == 4
   197                              <1>         %error "VPDPBUSD_RM: rsp/r12 as base needs a SIB byte; not supported"
   198                              <1>     %endif
   199                              <1>     VEX_0F38_66_256 YN_%+%1, YN_%+%2, %%b
   200                              <1>     %if (%4) == 0 && (%%b & 7) != 5
   201                              <1>         db 0x00 | (((YN_%+%1)&7)<<3) | (%%b&7)
   202                              <1>     %elif (%4) >= -128 && (%4) <= 127
   203                              <1>         db 0x40 | (((YN_%+%1)&7)<<3) | (%%b&7)
   204                              <1>         db (%4) & 0xFF
   205                              <1>     %else
   206                              <1>         db 0x80 | (((YN_%+%1)&7)<<3) | (%%b&7)
   207                              <1>         dd %4
   208                              <1>     %endif
   209                              <1> %endmacro
   210                              <1> 
   211                              <1> %endif
