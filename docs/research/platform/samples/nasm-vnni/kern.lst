   120                                  ; ============================================================ int8 kernels
   121                                  ; y[r] = clamp((b[r] + sum_c W[r][c] * x[c]) >> shift, 0, 127),  r < 32, c < 64
   122                                  ;   x  u8, every value 0..127       W  s8       b  s32       y  u8
   123                                  ; All kernels:  void f(const uint8_t *x, const int8_t *W, const int32_t *b,
   124                                  ;                      uint32_t shift, uint8_t *y);
   125                                  ;               rcx = x, rdx = W, r8 = b, r9d = shift, STK_ARG(5) = y
   126                                  ;
   127                                  ; Weight layouts
   128                                  ;   "c4"  (column-blocked, recommended): 2048 bytes,
   129                                  ;         Wc4[((c/4)*4 + r/8)*32 + (r%8)*4 + c%4] = W[r][c]
   130                                  ;         One 32-byte block holds 4 input columns for 8 output rows, so one
   131                                  ;         vpdpbusd against a broadcast input dword updates 8 rows.
   132                                  ;   "rm"  (row-major): Wrm[r*64 + c] = W[r][c]
   133                                  
   134                                  ; Shared tail: 4 vectors of 8 dword sums in ymm0..ymm3 -> shift, clamp, 32 bytes.
   135                                  ; vpackssdw saturates to s16, vpminsw caps at 127, vpackuswb floors at 0.
   136                                  %macro NN_TAIL 0
   137                                      vmovd       xmm4, r9d
   138                                      vpsrad      ymm0, ymm0, xmm4
   139                                      vpsrad      ymm1, ymm1, xmm4
   140                                      vpsrad      ymm2, ymm2, xmm4
   141                                      vpsrad      ymm3, ymm3, xmm4
   142                                      vpackssdw   ymm0, ymm0, ymm1
   143                                      vpackssdw   ymm2, ymm2, ymm3
   144                                      vmovdqa     ymm5, [c_127w]
   145                                      vpminsw     ymm0, ymm0, ymm5
   146                                      vpminsw     ymm2, ymm2, ymm5
   147                                      vpackuswb   ymm0, ymm0, ymm2
   148                                      vmovdqa     ymm4, [c_perm]
   149                                      vpermd      ymm0, ymm4, ymm0
   150                                      mov         rax, STK_ARG(5)
   151                                      vmovdqu     [rax], ymm0
   152                                      vzeroupper
   153                                  %endmacro
   154                                  
   155                                  ; ---- AVX-VNNI, c4 layout, %2 accumulator chains (4, 8 or 12) ------------
   156                                  ; Accumulators ymm0 .. ymm(%2-1); chain j of row block rb is ymm(rb + 4*j).
   157                                  ; The broadcast input dword lives in ymm(%2).
   158                                  ; %3 = 0: hand-encoded VEX vpdpbusd (needs AVX-VNNI)
   159                                  ; %3 = 1: "{vex} vpdpbssd", which NASM 2.16.03 does assemble (needs
   160                                  ;         AVX-VNNI-INT8).  Signed x signed gives the same sums because the
   161                                  ;         contract keeps every x byte in 0..127.
   162                                  %macro NN_VNNI_C4 3
   163                                    %assign NCH  %2
   164                                    %assign CPR  NCH/4
   165                                    %assign XB   NCH
   166                                    %if NCH+1 > 6
   167                                      %assign NSAVE NCH+1-6
   168                                    %else
   169                                      %assign NSAVE 0
   170                                    %endif
   171                                  PROC %1, 0, NSAVE
   172                                      vmovdqu     ymm0, [r8]
   173                                      vmovdqu     ymm1, [r8 + 32]
   174                                      vmovdqu     ymm2, [r8 + 64]
   175                                      vmovdqu     ymm3, [r8 + 96]
   176                                    %assign J 4
   177                                    %rep NCH-4
   178                                      vpxor       xmm%[J], xmm%[J], xmm%[J]
   179                                      %assign J J+1
   180                                    %endrep
   181                                    %assign G 0
   182                                    %rep 16
   183                                      vpbroadcastd ymm%[XB], [rcx + 4*G]
   184                                      %assign RB 0
   185                                      %rep 4
   186                                        %assign J RB + 4*(G % CPR)
   187                                        %if %3 == 0
   188                                        VPDPBUSD_RM ymm%[J], ymm%[XB], rdx, (G*4 + RB)*32
   189                                        %else
   190                                        {vex} vpdpbssd ymm%[J], ymm%[XB], [rdx + (G*4 + RB)*32]
   191                                        %endif
   192                                        %assign RB RB+1
   193                                      %endrep
   194                                      %assign G G+1
   195                                    %endrep
   196                                    %assign C 1
   197                                    %rep CPR-1
   198                                      %assign RB 0
   199                                      %rep 4
   200                                        %assign J RB + 4*C
   201                                        vpaddd    ymm%[RB], ymm%[RB], ymm%[J]
   202                                        %assign RB RB+1
   203                                      %endrep
   204                                      %assign C C+1
   205                                    %endrep
   206                                      NN_TAIL
   207                                      EPILOGUE
   208                                  ENDPROC
   209                                  %endmacro
   210                                  
