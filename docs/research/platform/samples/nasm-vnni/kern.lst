   488                                  ; ============================================================ clock helper
   489                                  ; uint64_t spin_add8(uint64_t n);  n iterations of 8 dependent register adds.
   490                                  ; A reg,reg add has 1 cycle of latency on every x86-64 core this targets, so
   491                                  ; the loop costs 8 core cycles per iteration whatever the clock frequency.
   492                                  global spin_add8
