        },
        {
          "@type": "cr:Field",
          "@id": "mechanisms/item",
          "name": "item",
          "dataType": "sc:Text",
          "source": { "fileObject": { "@id": "eval-mechanisms-csv" }, "extract": { "column": "item" } }
        },
        {
          "@type": "cr:Field",
          "@id": "mechanisms/mechanism",
          "name": "mechanism file:function",
          "dataType": "sc:Text",
          "source": { "fileObject": { "@id": "eval-mechanisms-csv" }, "extract": { "column": "mechanism file:function" } }
        },
        {
          "@type": "cr:Field",
          "@id": "mechanisms/lesion",
