# az_gpu_embed.cmake - check the PTX text and turn it into a C byte array.
#   cmake -DIN=<file.ptx> -DOUT=<file.c> -P az_gpu_embed.cmake
#
# Checks (the build fails if one does not hold):
#   - every kernel the host asks for is an entry point;
#   - no unresolved external function: the driver could not load such a module;
#   - no floating-point type anywhere: the GPU path is integers only, which is
#     what makes it bit-identical to the CPU.

if(NOT IN OR NOT OUT)
  message(FATAL_ERROR "usage: cmake -DIN=<ptx> -DOUT=<c> -P az_gpu_embed.cmake")
endif()

file(READ "${IN}" ptx)

foreach(k az_gpu_k_layout az_gpu_k_philox az_gpu_k_brain az_gpu_k_tile_brain az_gpu_k_kin_axis az_gpu_k_empty)
  if(NOT ptx MATCHES "\\.visible \\.entry ${k}\\(")
    message(FATAL_ERROR "az gpu: ${IN} has no entry point ${k}")
  endif()
endforeach()

string(REGEX MATCH "\\.extern \\.func[^\n]*\n[^\n]*" ext "${ptx}")
if(ext)
  message(FATAL_ERROR "az gpu: the device code calls a function it does not define:\n${ext}\n"
          "A file included by gpu/az_gpu_dev.c calls outside itself; declare that function "
          "static in az_gpu_dev.c and include its source in the device translation unit.")
endif()

string(REGEX MATCH "[^\n]*\\.f(16|32|64)[^\n]*" flt "${ptx}")
if(flt)
  message(FATAL_ERROR "az gpu: floating point in the device code:\n${flt}")
endif()

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR bytes "${hexlen} / 2")
# 20 bytes per line
string(REGEX REPLACE "(........................................)" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")

file(CONFIGURE OUTPUT "${OUT}" CONTENT
"/* generated by gpu/az_gpu_embed.cmake from az_gpu_dev.ptx: do not edit */
const char az_gpu_ptx[] = {
${hex}
0x00 };
const unsigned az_gpu_ptx_len = ${bytes}u;
" @ONLY NEWLINE_STYLE LF)
message(STATUS "az gpu: embedded ${bytes} bytes of PTX (entries present, no extern function, no float)")
